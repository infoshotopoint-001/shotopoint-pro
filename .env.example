# SPP Production backend — do not commit actual secrets
NODE_ENV=development
PUBLIC_URL=https://www.shotopoint.com
CORS_ORIGIN=https://www.shotopoint.com,https://shotopoint.com,http://localhost:3000
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ADMIN_REGISTRATION_ENABLED=false

# Remote MySQL database (Vercel must reach this host over TLS)
DB_HOST=YOUR_REMOTE_MYSQL_HOST
DB_PORT=3306
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=shoto_point
DB_SSL=true

# Persistent uploads — required for media on Vercel
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://YOUR_PUBLIC_R2_DOMAIN
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=4194304
MAX_DIRECT_UPLOAD_BYTES=2147483648

# Payments (optional; configure only when ready)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Source publishing (optional; GitHub -> Vercel integration)
RECODE_GITHUB_OWNER=
RECODE_GITHUB_REPO=
RECODE_GITHUB_BRANCH=main
RECODE_GITHUB_TOKEN=
RECODE_GITHUB_ROOT=
RECODE_VERCEL_DEPLOY_HOOK=
RECODE_TRIGGER_VERCEL_HOOK=false
CODE_EDITOR_ENABLED=false

# Have a Story / Creator Community. The service-role key is server-only; never put it in spp-community-config.js.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SPP AI Creative Studio. Keys are server-side only.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TEXT_MODEL=gpt-6-astra
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TEXT_MODEL=gemini-3.1-flash
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VERSION=2023-06-01
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE=https://api-singapore.klingai.com
KLING_VIDEO_MODEL=kling-3.0
YARNGPT_API_KEY=
# Google Flow is handled as a supported user export/import workflow.
# ShotoAI is reserved for a future SPP-owned provider.

# Basic AI usage guardrails (per admin account)
SPP_AI_MAX_ACTIVE_JOBS_PER_ADMIN=2
SPP_AI_MAX_JOBS_PER_DAY=20

# Newsroom feeds. BBC / FOX stay disabled until business-use permission is obtained.
NEWS_CACHE_TTL_MS=180000
SUN_RSS_ENABLED=true
VANGUARD_RSS_ENABLED=true
ALJAZEERA_RSS_ENABLED=true
BBC_RSS_LICENSED=false
FOX_RSS_LICENSED=false
SPP_YOUTUBE_CHANNEL_ID=
